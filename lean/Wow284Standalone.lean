    nlinarith
  · intro hk3
    have hk_cases : k = 2 ∨ k = 3 := by omega
    rcases hk_cases with rfl | rfl
    · have hsqrt_sq : (Real.sqrt (5 : ℝ)) ^ 2 = 5 := by
        exact Real.sq_sqrt (by norm_num)
      have hsqrt_nonneg : 0 ≤ Real.sqrt (5 : ℝ) := Real.sqrt_nonneg _
      norm_num
