              congrArg (fun p : ℝ[X] => p.eval z)
                (Polynomial.Chebyshev.U_add_two ℝ (1 : ℤ))
            norm_num [Polynomial.Chebyshev.U_one,
              Polynomial.Chebyshev.U_two] at hUthree
            norm_num [Polynomial.Chebyshev.U_one,
              Polynomial.Chebyshev.U_two]
