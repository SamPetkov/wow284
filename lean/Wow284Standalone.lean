    D = (2 : ℤ) • J - (2 : ℤ) • (1 : Matrix Vertex Vertex ℤ) - A := by
  ext u v
  simp only [D, J, A, Matrix.smul_apply, smul_eq_mul, Matrix.one_apply,
    Matrix.sub_apply]
  by_cases huv : u = v
  · subst v
    simp [adjacent_irrefl]
  · by_cases hadj : Adjacent u v <;> simp [huv, hadj]

