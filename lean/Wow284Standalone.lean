private lemma degree_coord (r : Fin 10) (c : Fin 5) : degree (coordVertex r c) = 7 := by
  have hrlt : r.val < 10 := r.isLt
  interval_cases hr : r.val
  · have er : r = 0 := Fin.ext (by exact hr)
    rw [er]
