  calc
    |s ^ i * (Polynomial.Chebyshev.U ℝ (i : ℤ)).eval z -
        s ^ (i - 2) *
          (Polynomial.Chebyshev.U ℝ ((i : ℤ) - 2)).eval z| ≤
        |s ^ i * (Polynomial.Chebyshev.U ℝ (i : ℤ)).eval z| +
