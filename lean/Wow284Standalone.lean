    have hnonneg : 0 ≤ dotProduct x x :=
      Finset.sum_nonneg fun i _ => mul_self_nonneg (x i)
    have hne : dotProduct x x ≠ 0 := (dotProduct_self_eq_zero).not.mpr hx
    exact lt_of_le_of_ne hnonneg hne.symm
